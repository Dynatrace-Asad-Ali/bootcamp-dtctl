{
  "name": "Bootcamp dtctl",
  "postStartCommand": "bash .devcontainer/scripts/setup-dynatrace.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "github.github-vscode-theme",
        "github.vscode-pull-request-github",
        "golang.go"
      ]
    }
  },

  // Declare expected Codespace secrets so GitHub prompts for them when creating the codespace.
  // Set these at: github.com/<org>/<repo>/settings/secrets/codespaces
  //
  // REQUIRED:
  //   DT_NAME   — label for the tenant, e.g. "prod"
  //   DT_URL    — tenant URL,  e.g. "https://abc123.apps.dynatrace.com"
  //   DT_TOKEN  — API token
  "secrets": {
    "DT_NAME": {
      "description": "Label for the Dynatrace tenant, e.g. 'prod'",
      "documentationUrl": "https://github.com/dynatrace-oss/dtctl#install"
    },
    "DT_URL": {
      "description": "Tenant URL, e.g. 'https://abc123.apps.dynatrace.com'",
      "documentationUrl": "https://github.com/dynatrace-oss/dtctl#install"
    },
    "DT_TOKEN_FOR_DTCTL": {
      "description": "Dynatrace API platform token",
      "documentationUrl": "https://github.com/dynatrace-oss/dtctl#install"
    }
  }
}
